# 复制为 .env 后填写。配了哪个渠道就用哪个，全都不配则只落盘不推送。
# 本地调试可用：npm run notify:test 向已配置渠道发一条测试消息。

# 飞书自定义机器人：群设置 -> 群机器人 -> 添加机器人 -> 自定义机器人
FEISHU_WEBHOOK=
# 仅当机器人安全设置勾选了"签名校验"时才需要填，否则留空
FEISHU_SECRET=

# 企业微信群机器人：群设置 -> 群机器人 -> 添加
WECOM_WEBHOOK=

# 个人微信方案一：Server 酱 https://sct.ftqq.com 扫码后获取 SendKey
SERVERCHAN_SENDKEY=

# 个人微信方案二：WxPusher https://wxpusher.zjiecode.com
# 创建应用拿 appToken，关注应用二维码后拿到 UID
WXPUSHER_APP_TOKEN=
WXPUSHER_UIDS=
# 或者用主题群发，填主题 ID（与 UIDS 二选一即可）
WXPUSHER_TOPIC_IDS=

# 网页地址，会附在推送消息末尾方便点进去看全量
SITE_URL=
